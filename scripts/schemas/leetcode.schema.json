{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/leetcode.schema.json",
  "type": "object",
  "properties": {
    "user": { "type": "string" },
    "generatedAt": { "type": "string" },
    "totals": {
      "type": "object",
      "properties": {
        "solved": { "type": "number" },
        "easy": { "type": "number" },
        "medium": { "type": "number" },
        "hard": { "type": "number" }
      },
      "required": ["solved", "easy", "medium", "hard"]
    },
    "streakDays": { "type": "number" },
    "weekly": { "type": "array" },
    "recent": { "type": "array" },
    "difficulty": { "type": "array" }
  },
  "required": ["user", "generatedAt", "totals", "streakDays"]
}
