---
import certsData from '../../../data/certs.json';
import CertCard from './CertCard.astro';

interface Palette {
  bg?: string;
  fg?: string;
  glow?: string;
}

interface CertItem {
  id: string;
  title: string;
  issuer: string;
  issued?: string;
  verifyUrl: string;
  category?: string;
  credId?: string;
  image: string;
  largeImage?: string;
  skills?: string[];
  palette?: Palette;
}

interface CertsData {
  featuredIds: string[];
  items: CertItem[];
}

const { items } = certsData as CertsData;
const marqueeItems = [...items, ...items];
const marqueeDuration = Math.max(24, items.length * 6);
---
<section
  id="certifications"
  aria-labelledby="certifications-title"
  class="certs-section py-12 sm:py-16"
>
  <div class="container">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xl">
        <h2 id="certifications-title" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          Certifications
        </h2>
        <p class="mt-2 text-base text-white/70">
          Recent credentials across cloud platforms, applied machine learning, and aviation technology.
        </p>
      </div>
      <p class="text-sm font-medium uppercase tracking-[0.3em] text-white/50">
        Auto-scrolling showcase
      </p>
    </div>

    <div class="certs-marquee mt-8" role="list" aria-label="Professional certifications">
      <div class="certs-track" style={`--certs-marquee-duration: ${marqueeDuration}s`}>
        {marqueeItems.map((cert, index) => {
          const isDuplicate = index >= items.length;
          return (
            <div
              class="certs-item"
              role={isDuplicate ? 'presentation' : 'listitem'}
              aria-hidden={isDuplicate ? 'true' : undefined}
            >
              <CertCard
                title={cert.title}
                issuer={cert.issuer}
                image={cert.image}
                palette={cert.palette}
                href={cert.verifyUrl}
                tabIndex={isDuplicate ? -1 : undefined}
              />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .certs-section {
    background: radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 55%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.65));
    overflow: hidden;
  }

  .certs-marquee {
    --certs-gap: 2.5rem;
    --certs-marquee-duration: 36s;
    overflow: hidden;
    padding: 1.5rem 0;
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
    contain: layout paint;
    max-width: 100vw;
    margin-inline: calc((100vw - 100%) / -2);
  }

  .certs-track {
    display: flex;
    align-items: stretch;
    gap: var(--certs-gap);
    width: max-content;
    animation: certs-marquee var(--certs-marquee-duration) linear infinite;
  }

  .certs-item {
    flex: 0 0 auto;
  }

  @keyframes certs-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .certs-track:hover,
  .certs-track:focus-within {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .certs-track {
      animation: none;
      transform: none;
    }
  }
</style>
