---
interface Palette {
  bg?: string;
  fg?: string;
  glow?: string;
}

interface Props {
  title: string;
  issuer: string;
  image: string;
  palette?: Palette;
  href: string;
  tabIndex?: number;
}

const { title, issuer, image, palette, href, tabIndex } = Astro.props as Props;

const style = [
  palette?.bg ? `--cert-card-bg: ${palette.bg}` : '',
  palette?.fg ? `--cert-card-fg: ${palette.fg}` : '',
  palette?.glow ? `--cert-card-glow: ${palette.glow}` : ''
]
  .filter(Boolean)
  .join('; ');
---
<a
  class="cert-card group flex items-center gap-4 rounded-3xl border border-white/10 px-5 py-4 transition duration-150 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/70 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
  style={style}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  tabindex={tabIndex}
>
  <span class="cert-card__badge flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl bg-white/10">
    <img
      src={image}
      alt={`${title} badge`}
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
      class="h-16 w-16 object-contain"
    />
  </span>
  <span class="flex min-w-0 flex-col text-left">
    <span class="text-xs font-semibold uppercase tracking-[0.18em] text-white/60">{issuer}</span>
    <span class="text-lg font-semibold leading-tight text-white transition-colors duration-150 group-hover:text-white group-focus-visible:text-white">
      {title}
    </span>
    <span class="mt-1 text-sm font-medium text-sky-200/80">Verify credential →</span>
  </span>
</a>

<style>
  .cert-card {
    background: var(
      --cert-card-bg,
      linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.9))
    );
    color: var(--cert-card-fg, #ffffff);
    box-shadow: 0 12px 30px rgba(8, 47, 73, 0.35);
    text-decoration: none;
  }

  .cert-card:hover,
  .cert-card:focus-visible {
    color: var(--cert-card-fg, #ffffff);
  }

  .cert-card__badge img {
    background: transparent;
  }
</style>
