---
interface Palette {
  bg?: string;
  fg?: string;
  glow?: string;
}

interface Props {
  title: string;
  issuer: string;
  issued: string;
  credId: string;
  largeImage: string;
  skills: string[];
  verifyUrl: string;
  palette?: Palette;
}

const {
  title,
  issuer,
  issued,
  credId,
  largeImage,
  skills,
  verifyUrl,
  palette
} = Astro.props as Props;

const issuedDate = (() => {
  const [year, month] = issued.split('-');
  const parsed = year && month ? new Date(Number(year), Number(month) - 1, 1) : undefined;
  return parsed ? parsed.toLocaleString('en-US', { month: 'long', year: 'numeric' }) : issued;
})();

const style = [
  palette?.bg ? `--cert-detail-bg: ${palette.bg}` : '',
  palette?.fg ? `--cert-detail-fg: ${palette.fg}` : '',
  palette?.glow ? `--cert-detail-glow: ${palette.glow}` : ''
]
  .filter(Boolean)
  .join('; ');
---
<div class="cert-detail" style={style} data-cert-detail>
  <div class="cert-detail__media">
    <img
      src={largeImage}
      alt={`${title} certification showcase`}
      width="720"
      height="450"
      loading="lazy"
      decoding="async"
      class="cert-detail__image"
    />
  </div>
  <div class="cert-detail__content">
    <p class="cert-detail__issuer">{issuer}</p>
    <h3 class="cert-detail__title">{title}</h3>
    <dl class="cert-detail__meta">
      <div>
        <dt>Issued</dt>
        <dd>{issuedDate}</dd>
      </div>
      <div>
        <dt>Credential ID</dt>
        <dd>{credId}</dd>
      </div>
    </dl>
    <ul class="cert-detail__skills" aria-label="Key skills">
      {skills.map(skill => (
        <li class="cert-detail__skill" role="listitem">{skill}</li>
      ))}
    </ul>
    <div class="cert-detail__actions">
      <a
        href={verifyUrl}
        class="cert-detail__verify"
        target="_blank"
        rel="noopener noreferrer"
        data-verify-button
      >
        Verify credential
      </a>
    </div>
  </div>
</div>

<style>
  .cert-detail {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background: var(
      --cert-detail-bg,
      linear-gradient(145deg, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.65))
    );
    color: var(--cert-detail-fg, #ffffff);
    box-shadow: 0 12px 40px -24px var(--cert-detail-glow, rgba(59, 130, 246, 0.45));
  }

  .cert-detail__media {
    border-radius: 1.25rem;
    overflow: hidden;
    position: relative;
  }

  .cert-detail__media::after {
    content: '';
    position: absolute;
    inset: auto 10% -25% 10%;
    height: 40%;
    filter: blur(50px);
    border-radius: 50%;
    background: var(--cert-detail-glow, rgba(79, 209, 197, 0.4));
    opacity: 0.65;
    pointer-events: none;
  }

  .cert-detail__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 1.25rem;
  }

  .cert-detail__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-detail__issuer {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .cert-detail__title {
    font-size: clamp(1.25rem, 2vw + 0.5rem, 1.85rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .cert-detail__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .cert-detail__meta dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .cert-detail__meta dd {
    margin: 0.125rem 0 0;
    font-weight: 500;
  }

  .cert-detail__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert-detail__skill {
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--cert-detail-glow, rgba(79, 209, 197, 0.35)) 30%, transparent);
    color: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cert-detail__actions {
    margin-top: 0.5rem;
  }

  .cert-detail__verify {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-weight: 600;
    background: var(--cert-detail-glow, rgba(59, 130, 246, 0.85));
    color: #0f172a;
    text-decoration: none;
    transition: opacity 120ms ease, background 120ms ease;
  }

  .cert-detail__verify:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .cert-detail__verify:hover {
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .cert-detail {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
    }
  }
</style>
