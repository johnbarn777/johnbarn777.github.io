---
interface Palette {
  bg?: string;
  fg?: string;
  glow?: string;
}

interface Props {
  title: string;
  issuer: string;
  issued: string;
  credId: string;
  largeImage: string;
  skills: string[];
  verifyUrl: string;
  palette?: Palette;
  loading?: 'lazy' | 'eager';
}

const {
  title,
  issuer,
  issued,
  credId,
  largeImage,
  skills,
  verifyUrl,
  palette,
  loading = 'lazy'
} = Astro.props as Props;

const issuedDate = (() => {
  const [year, month] = issued.split('-');
  const parsed = year && month ? new Date(Number(year), Number(month) - 1, 1) : undefined;
  return parsed ? parsed.toLocaleString('en-US', { month: 'long', year: 'numeric' }) : issued;
})();

const style = [
  palette?.bg ? `--cert-detail-bg: ${palette.bg}` : '',
  palette?.fg ? `--cert-detail-fg: ${palette.fg}` : '',
  palette?.glow ? `--cert-detail-glow: ${palette.glow}` : ''
]
  .filter(Boolean)
  .join('; ');
---
<div class="cert-detail" style={style} data-cert-detail>
  <div class="cert-detail__media">
    <img
      src={largeImage}
      alt={`${title} certification showcase`}
      width="640"
      height="360"
      loading={loading}
      decoding="async"
      class="cert-detail__image"
    />
  </div>
  <div class="cert-detail__content">
    <p class="cert-detail__issuer">{issuer}</p>
    <h3 class="cert-detail__title">{title}</h3>
    <dl class="cert-detail__meta">
      <div>
        <dt>Issued</dt>
        <dd>{issuedDate}</dd>
      </div>
      <div>
        <dt>Credential ID</dt>
        <dd>{credId}</dd>
      </div>
    </dl>
    <ul class="cert-detail__skills" aria-label="Key skills">
      {skills.map(skill => (
        <li class="cert-detail__skill" role="listitem">{skill}</li>
      ))}
    </ul>
    <div class="cert-detail__actions">
      <a
        href={verifyUrl}
        class="cert-detail__verify"
        target="_blank"
        rel="noopener noreferrer"
        data-verify-button
      >
        Verify credential
      </a>
    </div>
  </div>
</div>

<style>
  .cert-detail {
    --cert-detail-surface: linear-gradient(
      145deg,
      color-mix(in srgb, var(--neutral-50) 96%, transparent),
      color-mix(in srgb, var(--neutral-100) 86%, transparent)
    );
    --cert-detail-ink: var(--neutral-900);
    --cert-detail-muted: color-mix(in srgb, var(--neutral-600) 80%, transparent);
    --cert-detail-ring: color-mix(in srgb, var(--neutral-900) 12%, transparent);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1.5vw + 1rem, 2rem);
    border-radius: 1.5rem;
    background: var(--cert-detail-bg, var(--cert-detail-surface));
    color: var(--cert-detail-fg, var(--cert-detail-ink));
    box-shadow: 0 20px 45px -28px color-mix(in srgb, var(--cert-detail-glow, var(--brand-3)) 55%, transparent);
    border: 1px solid var(--cert-detail-ring);
  }

  .cert-detail__media {
    border-radius: 1.2rem;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 0;
  }

  .cert-detail__media::after {
    content: '';
    position: absolute;
    inset: auto 14% -30% 14%;
    height: 45%;
    filter: blur(45px);
    border-radius: 50%;
    background: var(--cert-detail-glow, rgba(79, 209, 197, 0.4));
    opacity: 0.55;
    pointer-events: none;
  }

  .cert-detail__image {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 1.2rem;
    object-fit: cover;
  }

  .cert-detail__content {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .cert-detail__issuer {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--cert-detail-muted);
  }

  .cert-detail__title {
    font-size: clamp(1.25rem, 2vw + 0.5rem, 1.85rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .cert-detail__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.65rem;
    font-size: 0.95rem;
  }

  .cert-detail__meta dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--cert-detail-muted) 92%, transparent);
  }

  .cert-detail__meta dd {
    margin: 0.125rem 0 0;
    font-weight: 500;
  }

  .cert-detail__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert-detail__skill {
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--cert-detail-glow, var(--brand-3)) 26%, transparent);
    color: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }

  .cert-detail__actions {
    margin-top: 0.25rem;
  }

  .cert-detail__verify {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-weight: 600;
    background: var(--cert-detail-glow, color-mix(in srgb, var(--brand-3) 82%, transparent));
    color: var(--cert-detail-button-ink, var(--neutral-900));
    text-decoration: none;
    transition: opacity 120ms ease, background 120ms ease;
  }

  .cert-detail__verify:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  :root[data-theme='dark'] .cert-detail,
  .dark .cert-detail {
    --cert-detail-surface: linear-gradient(
      145deg,
      color-mix(in srgb, var(--neutral-300) 14%, transparent),
      color-mix(in srgb, var(--neutral-200) 10%, transparent)
    );
    --cert-detail-ink: var(--neutral-50);
    --cert-detail-muted: color-mix(in srgb, var(--neutral-400) 85%, transparent);
    --cert-detail-ring: color-mix(in srgb, var(--neutral-200) 22%, transparent);
    --cert-detail-button-ink: var(--neutral-50);
    box-shadow: 0 20px 45px -28px color-mix(in srgb, var(--cert-detail-glow, var(--brand-4)) 42%, transparent);
  }

  :root[data-theme='dark'] .cert-detail__skills,
  .dark .cert-detail__skills {
    color: inherit;
  }

  :root[data-theme='dark'] .cert-detail__skill,
  .dark .cert-detail__skill {
    border-color: color-mix(in srgb, currentColor 32%, transparent);
  }

  :root[data-theme='dark'] .cert-detail__meta dt,
  .dark .cert-detail__meta dt {
    color: color-mix(in srgb, var(--cert-detail-muted) 120%, transparent);
  }

  :root[data-theme='dark'] .cert-detail__verify,
  .dark .cert-detail__verify {
    background: var(--cert-detail-glow, color-mix(in srgb, var(--brand-4) 78%, transparent));
  }

  @media (min-width: 768px) {
    .cert-detail {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .cert-detail {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>
