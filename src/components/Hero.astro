---
const { firstName = 'Yohann', lastName = '', titles = ['Developer'], ctas = [] } = Astro.props;
---
<section id="intro" class="section hero min-h-screen" aria-labelledby="intro-title">
  <div class="container hero-content flex flex-col items-center gap-6 text-center">
    <p
      class="text-text-muted text-sm tracking-[0.2em] uppercase font-heading"
      data-animate="fade-in"
    >
      Portfolio
    </p>
    <h1
      id="intro-title"
      class="text-hero font-bold flex items-center justify-center gap-1 flex-wrap font-heading"
      data-animate="fade-up"
    >
      <span id="hero-rotating-title">{`${firstName} ${lastName}`}</span>
      <span id="hero-cursor" class="hero-cursor" aria-hidden="true">|</span>
    </h1>
    <p
      class="text-text-secondary text-lg max-w-xl leading-relaxed"
      data-animate="fade-up"
      data-animate-delay="150"
    >
      Developer, ML Engineer & Innovator — building intelligent systems at the intersection of software and machine learning.
    </p>
    <div class="hero-ctas" data-animate="fade-up" data-animate-delay="300">
      {ctas.map(({ text, href }, i) => (
        <a href={href} class={`cta-button ${i > 0 ? 'cta-button--outline' : ''}`}>
          {text}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" data-animate="fade-in" data-animate-delay="800">
    <span>Scroll</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </div>
</section>

<script client:visible define:vars={{ firstName, lastName, titles }}>
(() => {
  const words = [`${firstName} ${lastName}`, ...titles];
  const el = document.getElementById('hero-rotating-title');
  const cursor = document.getElementById('hero-cursor');
  if (!el) return;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    el.innerHTML = `<span class="hero-firstname">${firstName}</span> ${lastName}`;
    if (cursor) cursor.style.display = 'none';
    return;
  }
  let wordIndex = 0;
  let charIndex = 0;
  let typing = true;

  function setContent(text) {
    if (words[wordIndex] === `${firstName} ${lastName}` && text === words[wordIndex]) {
      el.innerHTML = `<span class="hero-firstname">${firstName}</span> ${lastName} `;
    } else {
      el.textContent = text;
    }
  }

  function step() {
    const word = words[wordIndex];
    if (typing) {
      if (charIndex < word.length) {
        setContent(word.slice(0, charIndex + 1));
        charIndex++;
        setTimeout(step, 110);
      } else {
        typing = false;
        setTimeout(step, 1500);
      }
    } else {
      if (charIndex > 0) {
        setContent(word.slice(0, charIndex - 1));
        charIndex--;
        setTimeout(step, 60);
      } else {
        typing = true;
        wordIndex = (wordIndex + 1) % words.length;
        setTimeout(step, 300);
      }
    }
  }
  step();
})();
</script>
