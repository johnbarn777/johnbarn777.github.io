---
const { firstName = 'Yohann', lastName = '', titles = ['Developer'], ctas = [] } = Astro.props;
---
<div class="hero min-h-screen bg-base-200 text-center">
  <div class="hero-content flex flex-col items-center gap-4">
    <img src="/avatar.png" alt={`${firstName} ${lastName} avatar`} class="w-32 h-32 rounded-full" loading="lazy" />
    <h1 class="text-5xl font-bold">{`${firstName} ${lastName}`}</h1>
    {titles[0] && <p class="py-2 text-xl">{titles[0]}</p>}
    <div class="flex gap-4 flex-wrap justify-center">
      {ctas.map(({ text, href }) => (
        <a href={href} class="btn btn-primary">
          {text}
        </a>
      ))}
    </div>
  </div>
</div>
