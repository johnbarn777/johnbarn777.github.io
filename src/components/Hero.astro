---
const { firstName = 'Yohann', lastName = '', titles = ['Developer'], ctas = [] } = Astro.props;
---
<section id="intro" class="section hero min-h-screen" aria-labelledby="intro-title">
  <div class="container hero-content flex flex-col items-center gap-6 text-center">
    <img
      src="/avatar.png"
      alt={`${firstName} ${lastName} avatar`}
      class="w-64 md:w-80 lg:w-96 h-auto rounded-2xl"
      loading="lazy"
    />
    <h1
      id="intro-title"
      class="text-4xl sm:text-5xl lg:text-6xl font-bold flex items-center justify-center gap-1 flex-wrap"
    >
      <span id="hero-rotating-title">{`${firstName} ${lastName}`}</span>
      <span id="hero-cursor" class="hero-cursor" aria-hidden="true">|</span>
    </h1>
    <div class="hero-ctas">
      {ctas.map(({ text, href }) => (
        <a href={href} class="cta-button">
          {text}
        </a>
      ))}
    </div>
  </div>
</section>

<script client:visible define:vars={{ firstName, lastName, titles }}>
(() => {
  const words = [`${firstName} ${lastName}`, ...titles];
  const el = document.getElementById('hero-rotating-title');
  const cursor = document.getElementById('hero-cursor');
  if (!el) return;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    el.innerHTML = `<span class="hero-firstname">${firstName}</span> ${lastName}`;
    if (cursor) cursor.style.display = 'none';
    return;
  }
  let wordIndex = 0;
  let charIndex = 0;
  let typing = true;

  function setContent(text) {
    if (words[wordIndex] === `${firstName} ${lastName}` && text === words[wordIndex]) {
      el.innerHTML = `<span class="hero-firstname">${firstName}</span> ${lastName} `;
    } else {
      el.textContent = text;
    }
  }

  function step() {
    const word = words[wordIndex];
    if (typing) {
      if (charIndex < word.length) {
        setContent(word.slice(0, charIndex + 1));
        charIndex++;
        setTimeout(step, 110);
      } else {
        typing = false;
        setTimeout(step, 1500);
      }
    } else {
      if (charIndex > 0) {
        setContent(word.slice(0, charIndex - 1));
        charIndex--;
        setTimeout(step, 60);
      } else {
        typing = true;
        wordIndex = (wordIndex + 1) % words.length;
        setTimeout(step, 300);
      }
    }
  }
  step();
})();
</script>
