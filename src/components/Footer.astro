---
const socialLinks = [
  { href: 'https://github.com/johnbarn777', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/yohannp', label: 'LinkedIn' },
  { href: 'https://leetcode.com/u/yohannvp/', label: 'LeetCode' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-6">
        {socialLinks.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-text-primary transition-colors duration-300"
          >
            {link.label}
          </a>
        ))}
      </div>
      <p class="text-text-muted text-sm m-0">
        &copy; {year} Yohann Vinod Pinto
      </p>
      <a
        href="#intro"
        class="text-text-secondary hover:text-text-primary transition-colors duration-300 text-sm"
      >
        Back to top
      </a>
    </div>
  </div>
</footer>
