---
// "YP" drawn from Inter Bold outlines (generated alongside public/favicon.svg), so it
// renders identically whether or not the web font has loaded.
import letters from '../assets/monogram-path.txt?raw';

interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg class:list={['monogram', cls]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="currentColor"></rect>
  <path d={letters.trim()} fill="var(--mono-ink, #fff)"></path>
</svg>
