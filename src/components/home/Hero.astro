---
import { site } from '../../data/site';
---

<section class="hero" id="top" data-progress="hero" aria-labelledby="hero-title">
  <div class="hero-inner container">
    <p class="status hero-in" style="--n:0">
      <span class="pulse" aria-hidden="true"></span>
      <span>{site.role.title}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{site.role.org}</span>
      <span class="sep hide-sm" aria-hidden="true">·</span>
      <span class="hide-sm">{site.city}</span>
    </p>

    <h1 id="hero-title" class="hero-title">
      <span class="hero-in" style="--n:1">Enterprise AI that earns</span>
      <span class="hero-in" style="--n:2">its place <span class="grad-text">in production.</span></span>
    </h1>

    <p class="hero-sub hero-in" style="--n:3">
      I’m Yohann. I build AI that businesses can actually run: reliable on day one, affordable on day 300.
    </p>

    <div class="hero-cta hero-in" style="--n:4">
      <a class="btn btn-primary" href="#work">
        See the work
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12m0 0-5-5m5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>
  </div>

  <a class="scroll-cue hero-in" style="--n:6" href="#intro" aria-label="Scroll to the introduction">
    <span class="cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    --p: 0;
    position: relative;
    overflow: clip;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: calc(var(--nav-h) + 3rem) 6rem;
    text-align: center;
  }

  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
  }

  /* A soft scrim keeps the terrain lines from crossing the words. */
  .hero-inner::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--bg) 35%, color-mix(in oklab, var(--bg) 60%, transparent) 65%, transparent);
    pointer-events: none;
  }

  :global(html.motion) .hero-inner {
    opacity: calc(1 - var(--p) * 1.35);
    transform: translate3d(0, calc(var(--p) * -9vh), 0) scale(calc(1 - var(--p) * 0.06));
    filter: blur(calc(var(--p) * 6px));
    will-change: transform, opacity;
  }

  .status {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem 0.55rem;
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    background: color-mix(in oklab, var(--bg-elev) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--hair);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .status .sep {
    color: var(--faint);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    margin-right: 0.2rem;
    border-radius: 50%;
    background: var(--good);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--good);
    animation: pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .hero-title {
    font-size: var(--fs-display);
    font-weight: 680;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero-title > span {
    display: block;
    padding-bottom: 0.06em;
  }

  .hero-sub {
    max-width: 34rem;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--muted);
    letter-spacing: -0.012em;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 44px;
    height: 64px;
    margin-left: -22px;
    border-radius: 999px;
  }

  .cue-line {
    position: relative;
    width: 1px;
    height: 44px;
    background: var(--hair-strong);
    overflow: hidden;
  }

  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--ink);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    to {
      top: 100%;
    }
  }

  /* Load-in: quick and staggered, so the headline is readable almost at once. */
  :global(html.motion) .hero-in {
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--n) * 70ms + 40ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 0.6em, 0);
      filter: blur(6px);
    }
  }

  @media (max-width: 520px) {
    .hide-sm {
      display: none;
    }

    .status {
      flex-wrap: nowrap;
      font-size: 0.75rem;
      padding-inline: 0.75rem 0.85rem;
      white-space: nowrap;
    }

    .hero {
      text-align: left;
      place-items: end start;
      padding-bottom: 7rem;
    }

    .hero-inner {
      justify-items: start;
    }

    .status {
      justify-content: flex-start;
    }

    .hero-cta {
      justify-content: flex-start;
    }

    .hero-cta .btn {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 380px) {
    .status {
      flex-wrap: wrap;
      white-space: normal;
      padding: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (max-height: 560px) and (orientation: landscape) {
    .scroll-cue {
      display: none;
    }
  }
</style>
