---
import { work, moreWork } from '../../data/content';
import Visual from '../visuals/Visual.astro';

const figLabels = {
  arch: 'Fig. 1 · Orchestrator and sub-agents',
  bench: 'Fig. 2 · The benchmark',
  chat: 'Fig. 3 · Illustrative conversation',
} as const;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal><span class="idx">01</span> Selected work</p>
      <h2 class="h2" id="work-title" data-reveal style="--d:1">What I’m building at Mark Anthony Group.</h2>
      <p class="lede" data-reveal style="--d:2">
        Production agentic AI for an enterprise, today. Here are three pieces I can talk about in public.
      </p>
    </header>

    <div class="story" data-story>
      <div class="steps">
        {
          work.map((w, i) => (
            <article class:list={['step', { 'is-active': i === 0 }]} data-step aria-labelledby={`step-${w.id}`}>
              <div class="step-copy" data-reveal>
                <p class="step-idx mono">
                  {String(i + 1).padStart(2, '0')} <span>/ 0{work.length}</span>
                </p>
                <h3 class="step-title" id={`step-${w.id}`}>
                  {w.title}
                </h3>
                <p class="step-body">{w.body}</p>
                <ul class="chips" role="list" aria-label="Keywords">
                  {w.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
                {'link' in w && w.link && (
                  <a class="link-arrow" href={w.link.href}>
                    <span>{w.link.label}</span>
                    <span class="arr" aria-hidden="true">
                      →
                    </span>
                  </a>
                )}
              </div>
              <div class="step-figure card" data-inline-visual data-reveal>
                <p class="fig-label mono">{figLabels[w.visual]}</p>
                <Visual kind={w.visual} uid={`m${i}`} />
              </div>
            </article>
          ))
        }
      </div>

      <div class="stage">
        <div class="stage-frame card">
          {
            work.map((w, i) => (
              <div class:list={['panel', { 'is-active': i === 0 }]} data-panel aria-hidden={i === 0 ? 'false' : 'true'}>
                <p class="fig-label mono">{figLabels[w.visual]}</p>
                <div class="panel-body">
                  <Visual kind={w.visual} uid={`d${i}`} />
                </div>
              </div>
            ))
          }
          <div class="stage-foot" aria-hidden="true">
            <span class="mono"><span data-counter>01</span> / 0{work.length}</span>
            <span class="dots">
              {work.map((_, i) => <span class:list={['dot', { 'is-active': i === 0 }]} data-dot />)}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="more">
      <h3 class="more-title mono" data-reveal>More from the day job</h3>
      <ul class="more-grid" role="list">
        {
          moreWork.map((m, i) => (
            <li class="more-item" data-reveal style={`--d:${i}`}>
              <h4>{m.title}</h4>
              <p>{m.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fig-label {
    font-size: 0.6875rem;
    color: var(--faint);
    letter-spacing: 0.02em;
  }

  .steps {
    display: grid;
    gap: clamp(4rem, 3rem + 5vw, 7rem);
  }

  .step {
    display: grid;
    gap: 2rem;
  }

  .step-copy {
    display: grid;
    gap: 1.125rem;
    align-content: start;
    justify-items: start;
  }

  .step-idx {
    color: var(--accent);
  }

  .step-idx span {
    color: var(--faint);
  }

  .step-title {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 18ch;
  }

  .step-body {
    color: var(--muted);
    max-width: 34rem;
  }

  .step-figure {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1rem, 0.6rem + 1.8vw, 2rem);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
  }

  .stage {
    display: none;
  }

  /* ---- Desktop: one sticky stage, text scrolls beside it ---- */
  @media (min-width: 960px) {
    .story {
      --stage-h: min(38rem, calc(100vh - var(--nav-h) - 6rem));
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
      align-items: start;
    }

    .steps {
      gap: 0;
    }

    .step {
      min-height: 88vh;
      align-content: center;
    }

    .step-figure {
      display: none;
    }

    .step-copy {
      transition: opacity 0.5s var(--ease-out);
    }

    :global(html.js) .step:not(:global(.is-active)) .step-copy {
      opacity: 0.28;
    }

    .stage {
      display: block;
      position: sticky;
      top: calc(var(--nav-h) + (100vh - var(--nav-h) - var(--stage-h)) / 2);
      height: var(--stage-h);
      margin-top: calc((88vh - var(--stage-h)) / 2);
      margin-bottom: calc((88vh - var(--stage-h)) / 2);
    }

    .stage-frame {
      position: relative;
      height: 100%;
      border-radius: var(--r-xl);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }

    .panel {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-rows: auto 1fr;
      padding: 1.75rem 2rem 3.5rem;
      opacity: 0;
      transform: scale(0.97) translateY(12px);
      filter: blur(8px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.8s var(--ease-out),
        filter 0.6s var(--ease-out);
      pointer-events: none;
    }

    .panel:global(.is-active) {
      opacity: 1;
      transform: none;
      filter: none;
      pointer-events: auto;
    }

    .panel-body {
      display: grid;
      align-items: center;
      min-height: 0;
    }

    .stage-foot {
      position: absolute;
      left: 2rem;
      right: 2rem;
      bottom: 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--faint);
    }

    .dots {
      display: flex;
      gap: 6px;
    }

    .dot {
      width: 6px;
      height: 6px;
      border-radius: 99px;
      background: var(--hair-strong);
      transition:
        width 0.5s var(--ease-out),
        background-color 0.3s;
    }

    .dot:global(.is-active) {
      width: 22px;
      background: var(--accent);
    }
  }

  @media (min-width: 960px) and (max-height: 700px) {
    .story {
      --stage-h: calc(100vh - var(--nav-h) - 3rem);
    }

    .panel {
      padding: 1.25rem 1.5rem 3rem;
    }
  }

  /* ---- More from the day job ---- */
  .more {
    margin-top: clamp(5rem, 3rem + 6vw, 8rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--hair);
  }

  .more-title {
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .more-grid {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: 0;
  }

  .more-item h4 {
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }

  .more-item p {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
</style>
