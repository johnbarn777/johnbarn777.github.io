---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
const experiences: CollectionEntry<'experience'>[] = await getCollection('experience');
experiences.sort((a,b)=>b.data.year-a.data.year);
---
<section id="experience" class="py-16">
  <h2 class="text-4xl font-bold mb-8 text-center">Experience</h2>
  <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical px-2 md:px-0">
    {experiences.map((exp, idx) => (
      <li>
        <div class={idx % 2 === 0 ? 'timeline-start font-mono' : 'timeline-end font-mono'}>{exp.data.year}</div>
        <div class="timeline-middle"></div>
        <div class={idx % 2 === 0 ? 'timeline-end pb-4' : 'timeline-start pb-4'}>
          <div class="timeline-box p-0 glass surface-tinted">
            <div class="collapse collapse-arrow">
              <input type="checkbox" />
              <div class="collapse-title font-semibold">
                {exp.data.title}
              </div>
              <div class="collapse-content">
                <p>{exp.data.description}</p>
                {exp.data.tech && (
                  <div class="mt-2 flex flex-wrap gap-2">
                    {exp.data.tech.map(t => <span class="badge badge-outline">{t}</span>)}
                  </div>
                )}
                {exp.data.links && (
                  <div class="mt-2 flex gap-2 flex-wrap">
                    {exp.data.links.map(l => (
                      <a href={l.href} target="_blank" rel="noopener" class="link">{l.text}</a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
        <hr class="bg-base-300" />
      </li>
    ))}
  </ul>
</section>
