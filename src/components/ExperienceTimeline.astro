---
import experienceData from '../../data/experience.json';

const experienceFilters = ['All', 'AI/ML', 'Software', 'IT Support'] as const;

const parseDate = (value?: string) => {
  if (!value) return new Date(0);
  const normalised = String(value).trim().toLowerCase();
  if (normalised === 'present') {
    return new Date(8640000000000000);
  }
  const [year, month = '01'] = String(value).split('-');
  const yearNum = Number(year);
  const monthNum = Number(month);
  if (Number.isNaN(yearNum)) {
    return new Date(0);
  }
  return new Date(yearNum, Number.isNaN(monthNum) ? 0 : monthNum - 1);
};

const formatRange = (start?: string, end?: string) => {
  const startYear = String(start || '').split('-')[0];
  const endYear = String(end || '').split('-')[0];
  if (!startYear) return endYear || '';
  return `${startYear} – ${endYear || 'Present'}`;
};

const experiences = [...experienceData].sort((a, b) => parseDate(b.start) - parseDate(a.start));
---
<section
  id="experience"
  class="section"
  aria-labelledby="experience-title"
  data-filter-section="experience"
>
  <div class="container flex flex-col gap-8">
    <div class="experience-header" data-animate="fade-up">
      <h2 id="experience-title" class="section-title">Impact Timeline</h2>
      <p>
        Track the roles that delivered the biggest wins, from AI evaluation rigor to shipping resilient
        software.
      </p>
    </div>

    <div
      id="experience-filters"
      class="filter-toolbar"
      role="toolbar"
      aria-label="Filter timeline by discipline"
      data-filter-toolbar
    >
      {experienceFilters.map(value => (
        <button
          type="button"
          class="filter-button"
          data-filter-value={value}
          aria-pressed={value === 'All' ? 'true' : 'false'}
        >
          {value}
        </button>
      ))}
    </div>

    <div
      id="experience-active-filters"
      class="filter-summary"
      data-filter-summary
      aria-live="polite"
      aria-atomic="true"
    >
      <p id="experience-count" class="filter-count" data-filter-count>
        Showing 0 of {experiences.length}
      </p>
      <div class="filter-summary__chips" data-filter-chips hidden>
        <button type="button" class="filter-clear" data-filter-clear>Clear all</button>
      </div>
    </div>

    <div
      id="experience-list"
      class="experience-list"
      data-filter-list
      aria-live="polite"
      role="list"
    >
      {experiences.map((exp, index) => (
        <article
          class="experience-card"
          data-filter-item="experience"
          data-category={exp.category}
          data-index={String(index)}
          role="listitem"
          aria-label={`${exp.role} at ${exp.company}`}
        >
          <div class="experience-card__rail">
            {exp.logo ? (
              <img
                src={exp.logo}
                alt={`${exp.company} logo`}
                class="experience-card__logo"
                width="56"
                height="56"
                loading={index < 2 ? 'eager' : 'lazy'}
              />
            ) : (
              <div class="experience-card__logo" aria-hidden="true"></div>
            )}
            <p class="experience-card__dates">{formatRange(exp.start, exp.end)}</p>
          </div>
          <div class="experience-card__body">
            <h3 class="experience-card__title">
              <span>{exp.role}</span>
              <span class="experience-card__company">@ {exp.company}</span>
            </h3>
            <p class="experience-card__meta">{exp.location}</p>
            <p class="experience-card__summary">{exp.summary}</p>
            {Array.isArray(exp.metrics) && exp.metrics.length ? (
              <div class="experience-metrics">
                {exp.metrics.slice(0, 3).map(metric => (
                  <span class="experience-metric-chip">
                    <span>{metric.label}</span>
                    <strong>{metric.value}</strong>
                  </span>
                ))}
              </div>
            ) : null}
            {Array.isArray(exp.highlights) && exp.highlights.length ? (
              <ul class="experience-card__highlights">
                {exp.highlights.slice(0, 3).map(point => (
                  <li>{point}</li>
                ))}
              </ul>
            ) : null}
            {Array.isArray(exp.tech) && exp.tech.length ? (
              <div class="experience-tech">
                {exp.tech.map(tech => (
                  <span class="experience-tech-chip">{tech}</span>
                ))}
              </div>
            ) : null}
            {Array.isArray(exp.links) && exp.links.length ? (
              <div class="experience-links">
                {exp.links.map(link => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        </article>
      ))}
    </div>

    <div id="experience-empty" class="filter-empty" data-filter-empty hidden role="status" aria-live="polite">
      <h3>No matches found</h3>
      <p>Try removing filters or selecting 'All'.</p>
      <button type="button" class="filter-clear" data-filter-clear>Clear all filters</button>
    </div>
  </div>
</section>
