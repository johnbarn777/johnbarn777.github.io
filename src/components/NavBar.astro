  { text: 'Home', href: '#home' },
  { text: 'Experience', href: '#experience' },
  { text: 'Projects', href: '#projects' },
  { text: 'LinkedIn', href: 'https://www.linkedin.com', icon: 'linkedin', external: true },
  { text: 'GitHub', href: 'https://github.com', icon: 'github', external: true },
