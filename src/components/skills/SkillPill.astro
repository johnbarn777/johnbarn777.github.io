---
interface Props {
  name: string;
  icon: string;
  level?: string;
  years?: number;
}

const { name, icon, level, years } = Astro.props as Props;

const formatLevel = (value?: string) => {
  if (!value) return '';
  return `${value.charAt(0).toUpperCase()}${value.slice(1)}`;
};

const yearsDisplay = typeof years === 'number' && Number.isFinite(years)
  ? `${years.toString().replace(/\.0+$/, '')} ${years === 1 ? 'year' : 'years'}`
  : '';

const tooltipParts = [formatLevel(level), yearsDisplay].filter(Boolean);
const tooltip = tooltipParts.length ? `${name} — ${tooltipParts.join(' · ')}` : name;
---
<button
  type="button"
  class="skill-pill"
  data-skill-name={name}
  role="listitem"
  title={tooltip}
>
  <span class="skill-pill__icon" aria-hidden="true">
    <img src={icon} alt="" width="32" height="32" loading="lazy" decoding="async" />
  </span>
  <span class="skill-pill__label">{name}</span>
</button>
