---
// Markup only; behaviour lives in src/scripts/terminal.ts and loads on first open.
---

<dialog id="terminal" class="terminal" aria-labelledby="terminal-title">
  <div class="term-window">
    <div class="term-bar">
      <span class="term-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <p id="terminal-title" class="term-title">yohann@portfolio: ~</p>
      <button class="term-close" type="button" data-term-close aria-label="Close terminal">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="term-out" data-term-out role="log" aria-live="polite"></div>
    <form class="term-form" autocomplete="off">
      <div class="term-box">
        <label for="term-input" class="t-prompt">&gt;</label>
        <input
          id="term-input"
          data-term-input
          type="text"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="term-menu"
          aria-expanded="false"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          enterkeyhint="send"
          aria-label="Command"
          placeholder="Try /help"
        />
      </div>
      <ul id="term-menu" class="term-menu" data-term-menu role="listbox" aria-label="Commands" hidden></ul>
      <p class="term-hint" data-term-hint aria-hidden="true"><span>? for shortcuts</span><span>✻ static · 0 trackers</span></p>
    </form>
  </div>
</dialog>

<style is:global>
  .terminal {
    width: min(100% - 2rem, 44rem);
    max-height: min(80vh, 36rem);
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: #e6e6ea;
    overflow: visible;
  }

  .terminal::backdrop {
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .terminal[open] {
    animation: term-in 0.45s var(--ease-out);
  }

  @keyframes term-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  .term-window {
    display: flex;
    flex-direction: column;
    height: min(80vh, 36rem);
    border-radius: 16px;
    background: #121214;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 30px 80px -20px rgb(0 0 0 / 0.6);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .term-bar {
    display: grid;
    grid-template-columns: 4rem 1fr 4rem;
    align-items: center;
    padding: 0 0.5rem 0 1rem;
    height: 44px;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
    background: #1a1a1d;
  }

  .term-lights {
    display: flex;
    gap: 7px;
  }

  .term-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a3a3f;
  }

  .term-lights i:first-child {
    background: #ff5f57;
  }

  .term-lights i:nth-child(2) {
    background: #febc2e;
  }

  .term-lights i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    text-align: center;
    font-size: 0.75rem;
    color: #8a8a90;
  }

  .term-close {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: none;
    color: #a1a1a6;
    cursor: pointer;
  }

  .term-close:hover {
    color: #fff;
  }

  .term-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .term-out {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 0.25rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    overscroll-behavior: contain;
  }

  .t-echo {
    color: #f5f5f7;
    margin-top: 0.25rem;
  }

  .t-prompt {
    color: #8ebbe8;
  }

  .t-good {
    color: #7fcf9f;
  }

  .term-out a {
    color: #8ebbe8;
  }

  .t-dim {
    color: #8a8a90;
  }

  .t-warn {
    color: #e8b86e;
  }

  .t-cmd {
    color: #d97757;
  }

  .t-dot {
    color: #f5f5f7;
  }

  .t-dot-tool {
    color: #7fcf9f;
  }

  .t-line b {
    color: #f5f5f7;
    font-weight: 600;
  }

  .t-welcome {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 100%;
    padding: 0.6rem 1rem;
    border: 1px solid #d97757;
    border-radius: 10px;
    white-space: normal;
  }

  .t-star,
  .t-glyph {
    color: #d97757;
  }

  .t-glyph {
    display: inline-block;
    width: 1ch;
  }

  .t-spin {
    color: #d97757;
  }

  .motion .term-out .t-line {
    animation: t-line-in 0.25s var(--ease-out);
  }

  @keyframes t-line-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  .term-form {
    position: relative;
    padding: 0.5rem 1rem 0.75rem;
  }

  .term-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.85rem;
    border: 1px solid #3a3a3f;
    border-radius: 10px;
    transition: border-color 0.2s;
  }

  .term-form:focus-within .term-box {
    border-color: #6e6e75;
  }

  .term-box input {
    flex: 1;
    min-width: 0;
    min-height: 42px;
    border: 0;
    background: transparent;
    color: #f5f5f7;
    font: inherit;
    font-size: 16px;
    caret-color: #d97757;
  }

  .term-box input::placeholder {
    color: #6e6e75;
  }

  .term-box input:focus {
    outline: none;
  }

  .term-form:focus-within .t-prompt {
    color: #cfe3f7;
  }

  .term-hint {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.25rem 0;
    font-size: 0.75rem;
    color: #8a8a90;
  }

  .term-hint[hidden] {
    display: none;
  }

  .term-menu {
    max-height: 11rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    font-size: 0.8125rem;
  }

  .term-menu li {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) 1fr;
    gap: 1rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .term-menu li[aria-selected='true'] {
    background: rgb(217 119 87 / 0.14);
  }

  .term-menu li[aria-selected='true'] .t-cmd {
    color: #f0a081;
  }

  .term-menu li > .t-dim {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .term-hint span:last-child {
      display: none;
    }

    .term-menu li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
