---
import type { Component } from 'astro';
import Highlights from './Highlights.astro';
import Repos from './Repos.astro';
import LeetCode from './LeetCode.astro';
import Mastery from './Mastery.astro';

let github: any = null;
let leetcode: any = null;
try { github = (await import('../../../data/github.json')).default; } catch (_) { github = null; }
try { leetcode = (await import('../../../data/leetcode.json')).default; } catch (_) { leetcode = null; }

const tabs = [
  { id: 'highlights', label: 'Highlights' },
  { id: 'repos', label: 'Repos' },
  { id: 'leetcode', label: 'LeetCode' },
  { id: 'mastery', label: 'Mastery' },
];
---
<section id="prowess" class="section" aria-labelledby="prowess-title">
  <div class="container flex flex-col gap-6">
    <header data-animate="fade-up">
      <h2 id="prowess-title" class="section-title">Coding Prowess</h2>
      <p class="text-center text-text-secondary">GitHub activity, LeetCode practice, and skills mastery.</p>
    </header>

    <div class="filter-toolbar" role="tablist" aria-label="Prowess tabs" data-prowess-tabs>
      {tabs.map((tab, idx) => (
        <button
          id={`prowess-tab-${tab.id}`}
          class="filter-button"
          role="tab"
          data-prowess-tab={tab.id}
          aria-controls={`prowess-panel-${tab.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          tabindex={idx === 0 ? '0' : '-1'}
          type="button"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="flex flex-col gap-6" data-prowess-panels>
      <section
        id="prowess-panel-highlights"
        role="tabpanel"
        aria-labelledby="prowess-tab-highlights"
        data-prowess-panel="highlights"
      >
        <Highlights {github} {leetcode} />
      </section>

      <section
        id="prowess-panel-repos"
        role="tabpanel"
        aria-labelledby="prowess-tab-repos"
        hidden
        data-prowess-panel="repos"
      >
        <Repos {github} />
      </section>

      <section
        id="prowess-panel-leetcode"
        role="tabpanel"
        aria-labelledby="prowess-tab-leetcode"
        hidden
        data-prowess-panel="leetcode"
      >
        <LeetCode {leetcode} />
      </section>

      <section
        id="prowess-panel-mastery"
        role="tabpanel"
        aria-labelledby="prowess-tab-mastery"
        hidden
        data-prowess-panel="mastery"
      >
        <Mastery />
      </section>
    </div>

    <p class="sr-only" data-prowess-status aria-live="polite" aria-atomic="true">Highlights tab selected</p>
  </div>
</section>

<script client:load>
  (() => {
    const root = document.querySelector('[data-prowess-tabs]')?.closest('#prowess');
    if (!root) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReduced = reduceMotion.matches;

    const tablist = root.querySelector('[data-prowess-tabs]');
    const tabs = Array.from(root.querySelectorAll('[data-prowess-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-prowess-panel]'));
    const status = root.querySelector('[data-prowess-status]');

    const getIndex = () => tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
    const clamp = (i) => (i + tabs.length) % tabs.length;

    const select = (index) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        if (i === index) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
      const label = tabs[index]?.textContent?.trim() || 'Tab';
      if (status) status.textContent = `${label} tab selected`;
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const key = e.key;
        if (key === 'ArrowRight' || key === 'ArrowDown') {
          e.preventDefault();
          tabs[clamp(i + 1)]?.focus();
        } else if (key === 'ArrowLeft' || key === 'ArrowUp') {
          e.preventDefault();
          tabs[clamp(i - 1)]?.focus();
        } else if (key === 'Home') {
          e.preventDefault();
          tabs[0]?.focus();
        } else if (key === 'End') {
          e.preventDefault();
          tabs[tabs.length - 1]?.focus();
        } else if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          select(i);
        }
      });
    });

    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', e => { prefersReduced = e.matches; });
    }

    select(0);
  })();
</script>

