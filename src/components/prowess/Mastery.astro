---
import skillsData from '../../../data/skills.json';

type Level = 'beginner' | 'intermediate' | 'advanced';
const levelWeight: Record<Level, number> = { beginner: 0.6, intermediate: 0.8, advanced: 1 };

const items = Array.isArray((skillsData as any).items) ? (skillsData as any).items : [];

const scores = items.map((s: any) => {
  const years = typeof s.years === 'number' ? Math.max(0, Math.min(8, s.years)) : 0;
  const yearsFactor = Math.min(1, years / 5);
  const primaryFactor = s.primary ? 1 : 0.7;
  const level = (s.level || 'intermediate') as Level;
  const score = Math.round((primaryFactor * yearsFactor * (levelWeight[level] || 0.8)) * 100);
  return { name: s.name, score };
});

const top = scores
  .sort((a, b) => b.score - a.score)
  .slice(0, 8);
---
{top.length ? (
  <div class="flex flex-col gap-3">
    {top.map(item => (
      <div class="flex flex-col gap-2" aria-label={`${item.name} mastery ${item.score}%`}>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;">
          <span style="font-weight:600;">{item.name}</span>
          <span style="font-size:.9rem;color:var(--neutral-200);">{item.score}%</span>
        </div>
        <div style="height:10px;background:rgba(15,23,42,.08);border-radius:6px;overflow:hidden">
          <div style={`height:10px;width:${item.score}%;background: var(--brand-3);`} />
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="filter-empty" role="status" aria-live="polite">
    <p>No skills available to compute mastery.</p>
  </div>
)}
