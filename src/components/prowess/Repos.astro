---
const { github = null } = Astro.props as { github?: any };

const repos = Array.isArray(github?.repos) ? github.repos : [];

function sparklinePath(points: number[], width = 120, height = 32, padding = 2) {
  if (!Array.isArray(points) || points.length === 0) return '';
  const max = Math.max(1, ...points);
  const step = (width - padding * 2) / Math.max(1, points.length - 1);
  const scaleY = (v: number) => height - padding - (v / max) * (height - padding * 2);
  return points
    .map((v, i) => `${i === 0 ? 'M' : 'L'} ${padding + i * step},${scaleY(v)}`)
    .join(' ');
}
---
{repos.length ? (
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {repos.map((repo) => {
      const points = Array.isArray(repo.recentCommits) ? repo.recentCommits : [];
      const path = sparklinePath(points);
      const weeks = points.length;
      const aria = `Weekly commits for ${repo.name} (last ${weeks} weeks): ${(points).join(', ')}`;
      return (
        <article class="experience-card" data-filter-item="repos" aria-label={repo.name}>
          <div class="experience-card__body">
            <h3 class="experience-card__title" style="margin:0">
              <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name}</a>
            </h3>
            <p class="experience-card__meta">{repo.language || '—'} · {repo.commitCount || 0} commits</p>
            <svg
              viewBox="0 0 120 32"
              width="100%"
              height="32"
              role="img"
              aria-label={aria}
              style="--spark-color: var(--brand-3); color: var(--brand-3);"
            >
              <path d={path} fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>
        </article>
      );
    })}
  </div>
) : (
  <div class="filter-empty" role="status" aria-live="polite">
    <h3>No repositories available</h3>
    <p>Populate data/github.json to see repo trends and sparklines.</p>
  </div>
)}
