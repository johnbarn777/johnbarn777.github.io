---
import { nav, site, mailto } from '../data/site';
import Monogram from './Monogram.astro';

interface Props {
  variant?: 'home' | 'page' | 'tutoring';
}
const { variant = 'home' } = Astro.props;
const onHome = variant === 'home';
const links = variant === 'tutoring' ? [] : nav;
const cta =
  variant === 'tutoring'
    ? { href: mailto('Tutoring enquiry'), label: 'Book a session' }
    : { href: onHome ? '#contact' : '/#contact', label: 'Get in touch' };
---

<header class="site-nav" data-nav>
  <div class="nav-inner container">
    <a class="brand" href={onHome ? '#top' : '/'} aria-label={`${site.name}, home`}>
      <Monogram size={26} />
      <span class="brand-name">{site.name}</span>
    </a>

    {
      links.length > 0 && (
        <nav class="nav-links" aria-label="Primary">
          <ul role="list">
            {links.map((l) => (
              <li>
                <a href={onHome ? `#${l.id}` : l.href} data-spy={onHome ? l.id : undefined}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="nav-actions">
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="12" cy="12" r="4.2"></circle><path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
          ></path></svg
        >
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
      </button>
      <a class="btn btn-primary nav-cta" href={cta.href} data-spy={onHome ? 'contact' : undefined}>{cta.label}</a>
      {
        links.length > 0 && (
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-button>
            <span class="bars" aria-hidden="true">
              <span />
              <span />
            </span>
          </button>
        )
      }
    </div>
  </div>

  {
    links.length > 0 && (
      <div class="mobile-menu" id="mobile-menu" data-menu>
        <nav class="container" aria-label="Mobile">
          <ul role="list">
            {links.map((l, i) => (
              <li style={`--i:${i}`}>
                <a href={onHome ? `#${l.id}` : l.href}>{l.label}</a>
              </li>
            ))}
            <li style={`--i:${links.length}`}>
              <a href={onHome ? '#contact' : '/#contact'}>Contact</a>
            </li>
          </ul>
          <p class="mobile-meta" style={`--i:${links.length + 1}`}>
            <a href={site.linkedin}>LinkedIn</a>
            <a href={site.github}>GitHub</a>
            <a href="/tutoring">Tutoring</a>
          </p>
        </nav>
      </div>
    )
  }
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
  }

  .site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      backdrop-filter 0.35s var(--ease-out);
  }

  .site-nav:global(.is-scrolled)::before,
  :global(html.menu-open) .site-nav::before {
    background: var(--nav-bg);
    border-bottom-color: var(--hair);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }

  .nav-inner {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    text-decoration: none;
    font-weight: 620;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
    color: var(--ink);
    --mono-ink: var(--bg);
  }

  .brand :global(.monogram) {
    color: var(--ink);
    transition: transform 0.5s var(--ease-spring);
  }

  .brand:hover :global(.monogram) {
    transform: rotate(-8deg) scale(1.06);
  }

  .nav-links {
    margin-inline: auto;
  }

  .nav-links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--ink);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 7px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-spring);
  }

  .nav-links a[aria-current]::after {
    opacity: 1;
    transform: scale(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  .nav-links + .nav-actions {
    margin-left: 0;
  }

  .nav-cta {
    min-height: 36px;
    padding: 0 1rem;
    font-size: 0.875rem;
  }

  /* 44px hit area around a compact button */
  .nav-cta::before {
    content: '';
    position: absolute;
    inset: -4px -2px;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out);
  }

  .icon-btn:hover {
    background: var(--accent-soft);
  }

  .theme-btn svg {
    grid-area: 1 / 1;
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.6s var(--ease-spring),
      opacity 0.3s var(--ease-out);
  }

  .theme-btn .i-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .theme-btn[data-mode='dark'] .i-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .theme-btn[data-mode='dark'] .i-moon {
    opacity: 1;
    transform: none;
  }

  .menu-btn {
    display: none;
  }

  .bars {
    position: relative;
    width: 18px;
    height: 10px;
  }

  .bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }

  .bars span:first-child {
    top: 0;
  }

  .bars span:last-child {
    top: 8.4px;
  }

  .menu-btn[aria-expanded='true'] .bars span:first-child {
    top: 4.2px;
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .bars span:last-child {
    top: 4.2px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 49;
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    backdrop-filter: saturate(180%) blur(24px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--ease-out),
      visibility 0s linear 0.35s;
    overflow-y: auto;
  }

  .mobile-menu:global(.is-open) {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s var(--ease-out);
  }

  .mobile-menu nav {
    padding-block: 1.5rem 3rem;
  }

  .mobile-menu ul {
    margin: 0;
  }

  .mobile-menu li,
  .mobile-meta {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .mobile-menu:global(.is-open) li,
  .mobile-menu:global(.is-open) .mobile-meta {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 35ms + 60ms);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: 1.75rem;
    font-weight: 620;
    letter-spacing: -0.025em;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--hair);
  }

  .mobile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }

  .mobile-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  @media (max-width: 899px) {
    .nav-links {
      display: none;
    }

    .menu-btn {
      display: inline-grid;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-links + .nav-actions {
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .brand-name {
      font-size: 0.875rem;
    }

    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 359px) {
    .brand-name {
      display: none;
    }
  }
</style>
