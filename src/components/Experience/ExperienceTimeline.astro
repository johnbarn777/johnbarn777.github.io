---
---

<section class="h-screen flex items-center justify-center snap-start" id="experience">
  <div class="container mx-auto flex h-full flex-col justify-start px-4 py-8">
    <h2 class="mb-6 text-center text-4xl md:text-5xl"><span class="text-gradient">Experience</span></h2>
    <div class="scroll-container flex-1">
      <ol class="timeline relative flex space-x-8 md:space-x-12">
        {
          [
            { year: '2001', title: 'Born', desc: 'Came into the world and immediately started preparing to code.' },
            { year: '2006', title: 'First Computer', desc: 'Started exploring games and basic software.' },
            { year: '2012', title: 'Built a Website', desc: 'Created my first website using simple HTML and CSS.' },
            { year: '2015', title: 'Learning Python', desc: 'Began automating homework assignments with Python.' },
            { year: '2019', title: 'Finished High School', desc: 'Graduated and set sights on a CS degree.' },
            { year: '2020', title: 'University Start', desc: 'Enrolled in Computer Science program.' },
            { year: '2021', title: 'First Internship', desc: 'Assisted with web development at a local startup.' },
            { year: '2022', title: 'Club Leader', desc: 'Led the university coding club and organized hackathons.' },
            { year: '2023', title: 'Desktop Support', desc: 'Resolved IT inquiries and automated onboarding scripts.' },
            {
              year: '2023',
              title: 'Full Stack Dev Co-op',
              desc: 'Developed MVC apps and performed QA testing at Mark Anthony Group.',
            },
            {
              year: '2024',
              title: 'AI Trainer',
              desc: 'Helped train and correct large language models for coding tasks.',
            },
            {
              year: '2025',
              title: 'Exploring LLMs',
              desc: 'Researching generative AI and building personal projects.',
            },
          ].map((item, i, arr) => (
            <li class="relative flex min-w-[18rem] flex-col items-center" data-index={i}>
              <span class="absolute left-1/2 top-6 h-3 w-3 -translate-x-1/2 rounded-full bg-[#6befe0]" />
              {i < arr.length - 1 && <span class="absolute right-0 top-6 h-[3px] w-20 bg-[#6befe0]/30 md:w-24" />}
              <button class="event-trigger mb-6 text-center" aria-expanded="false">
                <h4 class="text-sm font-semibold">{item.year}</h4>
                <p class="text-sm">{item.title}</p>
              </button>
              <span class="absolute left-1/2 top-9 h-6 w-[3px] -translate-x-1/2 bg-[#6befe0]" />
              <div class="event-info dark:bg-dark-100 mt-2 hidden w-64 rounded-lg border border-neutral-700 bg-neutral-100 p-4 text-sm">
                {item.desc}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view')
          }
        })
      },
      { threshold: 0.5 }
    )

    document.querySelectorAll('.event-trigger').forEach((btn) => {
      observer.observe(btn)
      btn.addEventListener('click', () => {
        const info = btn.parentElement.querySelector('.event-info')
        const expanded = btn.getAttribute('aria-expanded') === 'true'
        btn.setAttribute('aria-expanded', !expanded)
        info.classList.toggle('hidden')
      })
    })
  })
</script>

<style lang="scss">
  .scroll-container {
    overflow-x: auto;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }
  .scroll-container::-webkit-scrollbar {
    display: none;
  }
  .timeline {
    position: relative;
  }
  .event-trigger {
    opacity: 0;
    transform: translateY(30px);
    transition: transform 0.5s ease-out, opacity 0.5s ease-out;

    &.in-view {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
