---

<section class="my-24" id="experience">
  <div class="container">
    <h2 class="mb-12 text-4xl md:text-5xl"><span class="text-gradient">Experience</span></h2>
    <div class="overflow-x-auto pb-4">
      <ol class="timeline flex space-x-8 md:space-x-12">
        {
          [
            { year: '2001', title: 'Born', desc: 'Came into the world and immediately started preparing to code.' },
            { year: '2006', title: 'First Computer', desc: 'Started exploring games and basic software.' },
            { year: '2012', title: 'Built a Website', desc: 'Created my first website using simple HTML and CSS.' },
            { year: '2015', title: 'Learning Python', desc: 'Began automating homework assignments with Python.' },
            { year: '2019', title: 'Finished High School', desc: 'Graduated and set sights on a CS degree.' },
            { year: '2020', title: 'University Start', desc: 'Enrolled in Computer Science program.' },
            { year: '2021', title: 'First Internship', desc: 'Assisted with web development at a local startup.' },
            { year: '2022', title: 'Club Leader', desc: 'Led the university coding club and organized hackathons.' },
            { year: '2023', title: 'Desktop Support', desc: 'Resolved IT inquiries and automated onboarding scripts.' },
            {
              year: '2023',
              title: 'Full Stack Dev Co-op',
              desc: 'Developed MVC apps and performed QA testing at Mark Anthony Group.',
            },
            {
              year: '2024',
              title: 'AI Trainer',
              desc: 'Helped train and correct large language models for coding tasks.',
            },
            {
              year: '2025',
              title: 'Exploring LLMs',
              desc: 'Researching generative AI and building personal projects.',
            },
          ].map((item, i, arr) => (
            <li class="relative flex w-48 flex-shrink-0 flex-col items-center" data-index={i}>
              <span class="bg-primary absolute left-1/2 top-0 h-3 w-3 -translate-x-1/2 rounded-full" />
              {i < arr.length - 1 && <span class="bg-primary/30 absolute left-full top-1.5 h-px w-8 md:w-12" />}
              <button
                class="event-card dark:bg-dark-100 mt-6 w-full rounded-lg border border-neutral-700 bg-neutral-200 p-4 text-left"
                aria-expanded="false"
              >
                <h4 class="text-sm font-semibold">{item.year}</h4>
                <p class="text-sm">{item.title}</p>
              </button>
              <div class="event-info dark:bg-dark-100 mt-2 hidden rounded-lg border border-neutral-700 bg-neutral-100 p-4 text-sm">
                {item.desc}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view')
          }
        })
      },
      { threshold: 0.5 }
    )

    document.querySelectorAll('.event-card').forEach((card) => {
      observer.observe(card)
      const btn = card
      btn.addEventListener('click', () => {
        const info = card.parentElement.querySelector('.event-info')
        const expanded = btn.getAttribute('aria-expanded') === 'true'
        btn.setAttribute('aria-expanded', !expanded)
        info.classList.toggle('hidden')
      })
    })
  })
</script>

<style lang="scss">
  .timeline {
    padding-bottom: 1rem;
  }
  .event-card {
    opacity: 0;
    transform: translateY(30px);
    transition: transform 0.5s ease-out, opacity 0.5s ease-out;

    &.in-view {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
