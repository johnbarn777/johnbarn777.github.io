---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
---
<section id="projects" class="projects">
  <div class="projects__bg" aria-hidden="true"></div>
  <div class="projects__content">
    <h2 class="sr-only">Projects</h2>
    <div class="projects__grid">
      {projects.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<style>
.projects{position:relative;padding:4rem 1rem;overflow:hidden;}
.projects__bg{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(45deg,#FDDBD9,#FAC9C3,#F5B8B1,#84A6E1,#8DCDE9,#B3E6FB);background-size:400% 400%;animation:bgMove 20s linear infinite;z-index:-1;}
.projects__bg::after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.25));}
@keyframes bgMove{0%{background-position:0% 50%;}50%{background-position:100% 50%;}100%{background-position:0% 50%;}}
@media(prefers-reduced-motion:reduce){.projects__bg{animation:none;}}
.projects__content{max-width:80rem;margin:0 auto;}
.projects__grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));}
@media(max-width:480px){.projects__grid{grid-template-columns:1fr;}}
@media(min-width:1440px){.projects__grid{grid-template-columns:repeat(4,1fr);}}
</style>
