---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
const projectFilters = ['All', 'Mobile', 'ML', 'Web', 'Data', 'Tools'] as const;
---
<section
  id="projects"
  class="section"
  aria-labelledby="projects-title"
  data-filter-section="projects"
>
  <div class="container flex flex-col gap-8">
    <div class="projects-header">
      <h2 id="projects-title" class="section-title">Projects</h2>
      <p>
        Explore shipped work across mobile, AI, data, and tooling — filter to the stacks that matter most to
        you.
      </p>
    </div>

    <div
      id="project-filters"
      class="filter-toolbar"
      role="toolbar"
      aria-label="Project filters"
      data-filter-toolbar
    >
      {projectFilters.map(value => (
        <button
          type="button"
          class="filter-button"
          data-filter-value={value}
          aria-pressed={value === 'All' ? 'true' : 'false'}
        >
          {value}
        </button>
      ))}
    </div>

    <div
      id="project-active-filters"
      class="filter-summary"
      data-filter-summary
      aria-live="polite"
      aria-atomic="true"
    >
      <p id="projects-count" class="filter-count" data-filter-count>
        Showing 0 of {projects.length}
      </p>
      <div class="filter-summary__chips" data-filter-chips hidden>
        <button type="button" class="filter-clear" data-filter-clear>Clear all</button>
      </div>
    </div>

    <div id="projects-featured" class="projects-featured" aria-live="polite" hidden></div>

    <div
      id="projects-gallery"
      class="projects-gallery grid gap-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4"
      data-filter-list
      role="list"
      aria-live="polite"
    >
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>

    <div id="projects-empty" class="filter-empty" data-filter-empty hidden role="status" aria-live="polite">
      <h3>No matches found</h3>
      <p>Try removing filters or selecting 'All'.</p>
      <button type="button" class="filter-clear" data-filter-clear>Clear all filters</button>
    </div>
  </div>
</section>
