---
const experiences = [
  { role: 'Software Engineer', company: 'ExampleCorp', period: '2022 - Present' },
];
---
<section id="experience" class="experience">
  <h2 class="experience__heading">Experience</h2>
  <ul class="experience__list">
    {experiences.map(e => (
      <li class="experience__item">
        <span class="experience__role">{e.role}</span>
        <span class="experience__company">{e.company}</span>
        <span class="experience__period">{e.period}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .experience{padding:4rem 1rem;color:#fff;text-align:center;}
  .experience__list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1rem;}
  .experience__item{display:flex;flex-direction:column;gap:.25rem;}
  .experience__heading{font-size:clamp(2rem,6vw,3rem);margin-bottom:2rem;}
</style>
