---
import tailwindConfig from '../../tailwind.config.mjs';
const screens = tailwindConfig.theme.screens;
---
<!doctype html>
<html lang="en">
        <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Y V P</title>
        <!-- Include Tailwind via CDN for styling -->
        <script>{`tailwind.config = {theme:{screens:${JSON.stringify(screens)}}}`}</script>
        <script src="https://cdn.tailwindcss.com"></script>
        </head>
        <body>
                <div class="page-bg" aria-hidden="true"></div>
                <slot />
        </body>
</html>

<style>
        html,
        body {
                margin: 0;
                width: 100%;
                height: 100%;
        }
        html {
                scroll-behavior: smooth;
        }
        .page-bg{
                position:fixed;
                top:0;
                left:0;
                width:100%;
                height:100%;
                background:linear-gradient(45deg,#FDDBD9,#FAC9C3,#F5B8B1,#84A6E1,#8DCDE9,#B3E6FB);
                background-size:400% 400%;
                animation:bgMove 20s linear infinite;
                z-index:-1;
        }
        @keyframes bgMove{
                0%{background-position:0% 50%;}
                50%{background-position:100% 50%;}
                100%{background-position:0% 50%;}
        }
        @media(prefers-reduced-motion:reduce){.page-bg{animation:none;}}
</style>
