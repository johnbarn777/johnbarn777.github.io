---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import filteringScript from '../scripts/filtering.ts?url';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <meta name="generator" content={Astro.generator} />
    <title>Yohann Vinod Pinto</title>
    <slot name="head" />
    <script is:inline>
      (function themeInitializer() {
        const storageKey = 'theme-preference';
        const root = document.documentElement;
        const readStored = () => {
          try { return localStorage.getItem(storageKey); } catch (_) { return null; }
        };
        const initial = readStored() ?? 'dark';
        root.dataset.theme = initial;
        root.classList.toggle('dark', initial === 'dark');
        root.style.colorScheme = initial === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="site-body">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="page-bg" aria-hidden="true"></div>

    <!-- Custom Cursor (desktop only) -->
    <div class="custom-cursor" aria-hidden="true"></div>

    <header class="site-header" role="banner">
      <Navbar />
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <!-- Theme Controller -->
    <script is:inline>
      (function themeController() {
        const storageKey = 'theme-preference';
        const root = document.documentElement;

        const readStored = () => {
          try { return localStorage.getItem(storageKey); } catch (_) { return null; }
        };

        const writeStored = (v) => {
          try { localStorage.setItem(storageKey, v); } catch (_) {}
        };

        const getToggles = () => Array.from(document.querySelectorAll('[data-theme-toggle]'));

        const syncToggle = (toggle, isDark) => {
          toggle.setAttribute('aria-pressed', String(isDark));
          const label = toggle.querySelector('[data-theme-label]');
          if (label) label.textContent = isDark ? 'Switch to light mode' : 'Switch to dark mode';
          const moon = toggle.querySelector('[data-theme-icon="moon"]');
          const sun = toggle.querySelector('[data-theme-icon="sun"]');
          if (moon) moon.hidden = isDark;
          if (sun) sun.hidden = !isDark;
        };

        const apply = (theme) => {
          const resolved = theme === 'dark' ? 'dark' : 'light';
          root.dataset.theme = resolved;
          root.classList.toggle('dark', resolved === 'dark');
          root.style.colorScheme = resolved === 'dark' ? 'dark' : 'light';
          getToggles().forEach(t => syncToggle(t, resolved === 'dark'));
        };

        const toggle = () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          apply(next);
          writeStored(next);
        };

        const stored = readStored();
        if (stored) apply(stored);

        document.addEventListener('DOMContentLoaded', () => {
          const toggles = getToggles();
          if (!toggles.length) return;
          apply(root.dataset.theme ?? 'dark');
          toggles.forEach(t => t.addEventListener('click', toggle));
        });
      })();
    </script>

    <!-- Hide Navbar on Scroll Down, Show on Scroll Up -->
    <script is:inline>
      (function scrollHeader() {
        const header = document.querySelector('.site-header');
        if (!header) return;
        let lastY = 0;
        let ticking = false;
        const threshold = 60;

        const update = () => {
          const y = window.scrollY;
          if (y > threshold && y > lastY) {
            header.classList.add('is-hidden-up');
          } else {
            header.classList.remove('is-hidden-up');
          }
          lastY = y;
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
      })();
    </script>

    <!-- Scroll Animation Observer -->
    <script is:inline>
      (function scrollAnimations() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const delay = entry.target.dataset.animateDelay || 0;
              setTimeout(() => {
                entry.target.classList.add('is-visible');
              }, Number(delay));
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -40px 0px',
        });

        const init = () => {
          document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <!-- Custom Cursor -->
    <script is:inline>
      (function customCursor() {
        if (window.matchMedia('(pointer: coarse)').matches) return;

        const cursor = document.querySelector('.custom-cursor');
        if (!cursor) return;

        let mouseX = 0, mouseY = 0;
        let cursorX = 0, cursorY = 0;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        }, { passive: true });

        const interactiveSelectors = 'a, button, [role="button"], input, textarea, select, .cta-button, .filter-button, .skill-pill, .project-card, .nav-link';

        document.addEventListener('mouseover', (e) => {
          if (e.target.closest(interactiveSelectors)) {
            cursor.classList.add('is-hovering');
          }
        });

        document.addEventListener('mouseout', (e) => {
          if (e.target.closest(interactiveSelectors)) {
            cursor.classList.remove('is-hovering');
          }
        });

        function animate() {
          cursorX += (mouseX - cursorX) * 0.15;
          cursorY += (mouseY - cursorY) * 0.15;
          cursor.style.transform = `translate(${cursorX - 10}px, ${cursorY - 10}px)`;
          requestAnimationFrame(animate);
        }
        animate();
      })();
    </script>

    <script type="module" src="/assets/js/filtering.js"></script>
  </body>
</html>
